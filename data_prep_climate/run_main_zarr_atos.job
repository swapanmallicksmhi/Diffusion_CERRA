#!/bin/bash 
#SBATCH -N 1
###SBATCH --nodes 1

#SBATCH -t 00:30:00 
#SBATCH -J zarrconv
#SBATCH --chdir=/ec/res4/scratch/smf/log/log_sdm
#SBATCH --error=%x-%j.error 
#SBATCH --output=%x-%j.out
#SBATCH --gpus=1
#SBATCH --qos=ng
##BATCH --mem-per-cpu=4G

###SBATCH --ntasks=128
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=100G
#SBATCH --account=spsewang

set -evx
ENV_NAME='sdm'
source $PERM/venvs/${ENV_NAME}/bin/activate

# Paths
input_highres_nc="/perm/smf/HCLIMAI/Test_Domain/cropped/ECMWF-ERAINT"
input_lowres_nc="/perm/smf/HCLIMAI/Test_Domain/original/ECMWF-ERAINT"
outputdir="/scratch/smf/HCLIMAI/Diffusion_SDM/ZARR/PLOTS/"
zarrpath="/scratch/smf/HCLIMAI/Diffusion_SDM/climate_3km_v2.zarr"

# Variables
lowres_variables="ta500 ta700 ta850 ta950"
highres_variables="tas"

mkdir -p ${outputdir}
rm -rf ${zarrpath}

cd $HOME/Scripts/Diffusion_CERRA/data_prep_climate/
# Run script
python3 main_zarr.py \
    --grid_size 106 \
    --lowres_dir ${input_lowres_nc} \
    --highres_dir ${input_highres_nc} \
    --output_dir ${outputdir} \
    --zarr_path ${zarrpath} \
    --lowres_variables ${lowres_variables} \
    --highres_variables ${highres_variables}
#    --era5land_dir ${input_nc} \
