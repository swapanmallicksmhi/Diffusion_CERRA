#!/bin/bash
#SBATCH -N 1
#SBATCH -t 00:30:00
#SBATCH -J zarrconv
###SBATCH -n 1  ##ntasks 
###SBATCH --mem=256000 
#SBATCH --chdir=/nobackup/rossby26/users/sm_fuxwa/AI/log_sdm
#SBATCH --error=%x-%j.error 
#SBATCH --output=%x-%j.out
#SBATCH -A rossby
###SBATCH --qos=low

set -evx

module load Mambaforge/23.3.1-1-hpc1
ENV_NAME='sdm'
mamba activate ${ENV_NAME}

# Paths
input_highres_nc="/nobackup/rossby26/users/sm_fuxwa/AI/Test_Domain/cropped/ECMWF-ERAINT"
input_lowres_nc="/nobackup/rossby26/users/sm_fuxwa/AI/Test_Domain/original/ECMWF-ERAINT"
outputdir="/nobackup/rossby26/users/sm_fuxwa/AI/Diffusion_SDM/ZARR/PLOTS/"
zarrpath="/nobackup/rossby26/users/sm_fuxwa/AI/Diffusion_SDM/climate_3km_v2.zarr"

# Variables
lowres_variables="ta500 ta700 ta850 ta950"
#lowres_variables="ta500" # ta700 ta850 ta950"
highres_variables="tas"

mkdir -p ${outputdir}
rm -rf ${zarrpath}

cd $HOME/Script/Diffusion_CERRA/data_prep_climate/
# Run script
python3 main_zarr.py \
    --grid_size 106 \
    --lowres_dir ${input_lowres_nc} \
    --highres_dir ${input_highres_nc} \
    --output_dir ${outputdir} \
    --zarr_path ${zarrpath} \
    --lowres_variables ${lowres_variables} \
    --highres_variables ${highres_variables}
#    --era5land_dir ${input_nc} \
